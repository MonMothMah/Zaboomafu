RewriteEngine On

# SEO-friendly URLs
RewriteRule ^bookmarklet/([0-9]+)/?$ index.php?page=bookmarklet&id=$1 [L,QSA]
RewriteRule ^category/([^/]+)/?$ index.php?page=category&name=$1 [L,QSA]
RewriteRule ^search/?$ index.php?page=search [L,QSA]
RewriteRule ^install/?$ index.php?page=install [L,QSA]
RewriteRule ^admin/?$ index.php?page=admin [L,QSA]

# Security headers
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options nosniff
    Header always set X-Frame-Options DENY
    Header always set X-XSS-Protection "1; mode=block"
</IfModule>

# Prevent access to sensitive files
<Files ~ "^config\.php$|\.json$|\.log$">
    Order allow,deny
    Deny from all
</Files>

# Cache static assets
<IfModule mod_expires.c>
    ExpiresActive on
    ExpiresByType text/css "access plus 1 month"
    ExpiresByType application/javascript "access plus 1 month"
    ExpiresByType image/png "access plus 1 month"
    ExpiresByType image/jpg "access plus 1 month"
    ExpiresByType image/jpeg "access plus 1 month"
    ExpiresByType image/gif "access plus 1 month"
</IfModule>